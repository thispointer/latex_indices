{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build LaTeX with Index",
            "type": "shell",
            "command": "./build_latex.sh",
            "args": [
                "${fileBasename}" // Pass the current file's name as an argument
            ],
            "group": "build",
            "problemMatcher": "$latexworkshop",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}